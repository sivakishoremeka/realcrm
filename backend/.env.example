PORT=5000

# Option A — Atlas SRV (works when Node DNS SRV lookups succeed):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/realcrm?retryWrites=true&w=majority

# Option B — Direct hosts (use this if you see querySrv ECONNREFUSED on Windows):
# MONGO_URI=mongodb://USER:PASSWORD@host0:27017,host1:27017,host2:27017/realcrm?ssl=true&replicaSet=atlas-XXXX-shard-0&authSource=admin&retryWrites=true&w=majority

# Option C — Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/realcrm

MONGO_URI=mongodb://127.0.0.1:27017/realcrm
MONGO_DB_NAME=realcrm
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@realcrm.app

# Google Sign-In — Web OAuth client ID (and optional Android/iOS IDs, comma-separated)
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_IDS=webId.apps.googleusercontent.com,androidId.apps.googleusercontent.com

# Public HTTPS base URL (required for Instagram video fetch — use ngrok in dev)
PUBLIC_API_URL=https://your-tunnel.example.com
TOKEN_ENC_KEY=long_random_string_for_token_encryption

# Agents paste their own OpenAI keys in the mobile Profile screen (encrypted with TOKEN_ENC_KEY).
# No shared platform OPENAI_API_KEY is required.

# Meta / Instagram Graph API (Business + Facebook Page)
META_APP_ID=
META_APP_SECRET=
# META_REDIRECT_URI defaults to {PUBLIC_API_URL}/api/instagram/callback
# META_REDIRECT_URI=https://your-tunnel.example.com/api/instagram/callback

# AWS S3 — owner listing photos (keys under listings/{ownerId}/{listingId}/)
S3_BUCKET_NAME=realcrm-data
AWS_REGION=ap-south-1
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
# Optional CDN / custom public base (defaults to https://{bucket}.s3.{region}.amazonaws.com)
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# Presigned GET URLs for private buckets (seconds). Default 6 hours.
# S3_SIGNED_URL_TTL=21600
